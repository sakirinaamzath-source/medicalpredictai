import kagglehub
import pandas as pd
import os

# 1. Download a reliable, large kidney dataset (contains 1,659 records)
path = kagglehub.dataset_download("rabieelkharoua/chronic-kidney-disease-dataset-analysis")
print("Downloaded to temporary cache:", path)

# 2. Locate the CSV file inside the download path
downloaded_files = os.listdir(path)
csv_file = [f for f in downloaded_files if f.endswith('.csv')][0]
full_source_path = os.path.join(path, csv_file)

# 3. Read it into Pandas and slice out EXACTLY 1,000 records
df_full = pd.read_csv(full_source_path)
df_1000 = df_full.head(1000)

# 4. Save the exact 1,000 rows directly into your sidebar folder
destination_path = "./kidney_1000.csv"
df_1000.to_csv(destination_path, index=False)

print(f"\n✨ SUCCESS! Sliced data and saved as '{destination_path}'")
print(f"Verified row count: {len(df_1000)} rows")

# 5. Display a quick preview to confirm the data is healthy
print("\n--- DATA PREVIEW ---")
print(df_1000[['Age', 'Gender', 'BloodPressure', 'Diagnosis']].head())